APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dormitory_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DORMITORY_NAME="Cozy Haven Dormitory"
DORMITORY_ADDRESS="San Ildefonso, Bulacan, Philippines"
# Add verified coordinates before enabling the interactive map and automatic directions.
DORMITORY_LATITUDE=15.0755105
DORMITORY_LONGITUDE=120.9583190

# DORA AI remains disabled until explicitly enabled with valid providers and approved knowledge.
DORA_AI_ENABLED=false
DORA_LLM_PROVIDER=gemini
DORA_LLM_MODEL=
DORA_LLM_API_KEY=
DORA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DORA_LLM_TIMEOUT=30

DORA_EMBEDDING_PROVIDER=gemini
DORA_EMBEDDING_MODEL=
DORA_EMBEDDING_API_KEY=
DORA_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DORA_EMBEDDING_TIMEOUT=30
DORA_EMBEDDING_DIMENSIONS=

DORA_VECTOR_PROVIDER=qdrant
DORA_VECTOR_ENDPOINT=http://localhost:6333
DORA_VECTOR_API_KEY=
DORA_VECTOR_INDEX=dora_knowledge
DORA_VECTOR_NAMESPACE=

DORA_RETRIEVAL_LIMIT=5
DORA_CHAT_HISTORY_LIMIT=12
DORA_MAX_TOOL_ROUNDS=3
